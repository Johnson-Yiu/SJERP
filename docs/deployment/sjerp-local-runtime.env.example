# Supply explicit instance values in /etc/sjerp/<instance>/runtime.env (0600).
APP_STAGE=staging
DJANGO_ALLOWED_HOSTS=erp-a.example.invalid
DJANGO_SECRET_KEY=
# Include an explicit port and runtime role. Supply credentials via a protected libpq passfile.
DATABASE_URL=postgresql://sjerp_a_runtime@127.0.0.1:5432/sjerp_a?connect_timeout=5
PGPASSFILE=/etc/sjerp/a/runtime.pgpass
SJERP_EXPECTED_DB_HOST=127.0.0.1
SJERP_EXPECTED_DB_PORT=5432
SJERP_EXPECTED_DB_NAME=sjerp_a
SJERP_EXPECTED_DB_USER=sjerp_a_runtime
MEDIA_ROOT=/var/lib/sjerp/a/private-media
SJERP_EXPECTED_MEDIA_ROOT=/var/lib/sjerp/a/private-media
SJERP_HTTP_HOST=erp-a.example.invalid
SJERP_HTTP_PORT=18131
